<?xml version="1.0" encoding="utf-8"?>
<!-- Exact sizing supports compact, medium, and wide 14-calendar-day layouts. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="450dp"
    android:maxResizeHeight="500dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_heatmap_placeholder"
    android:description="@string/widget_heatmap_description"
    android:widgetCategory="home_screen" />
