<?xml version="1.0" encoding="utf-8"?>
<!--
  Checkpoint 4e: ukuran disesuaikan sama breakpoint baru di HeatmapWidget.kt
  (SIZE_SMALL 220x90dp menampilkan sampai 3 baris habit, SIZE_LARGE
  220x220dp sampai 8 baris), desain per-habit-row, bukan grid agregat lagi
  (checkpoint 4c).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="220dp"
    android:minHeight="90dp"
    android:targetCellWidth="5"
    android:targetCellHeight="2"
    android:resizeMode="vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_heatmap_placeholder"
    android:description="@string/widget_heatmap_description"
    android:widgetCategory="home_screen" />
