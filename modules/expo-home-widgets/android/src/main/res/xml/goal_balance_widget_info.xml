<?xml version="1.0" encoding="utf-8"?>
<!--
  Checkpoint 4d: `android:configure` sekarang nunjuk ke Configuration
  Activity beneran (sebelumnya sengaja dikosongin di checkpoint 4a karena
  activity-nya belum ada). Ukuran disesuaikan sama breakpoint responsive di
  GoalBalanceWidget.kt (SIZE_SMALL 140x90dp, SIZE_LARGE 250x110dp).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/widget_goal_balance_placeholder"
    android:configure="expo.modules.homewidgets.widgets.GoalBalanceConfigActivity"
    android:description="@string/widget_goal_balance_description"
    android:widgetCategory="home_screen" />
