<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".widgets.HeatmapWidgetProvider"
            android:exported="false"
            android:label="@string/widget_heatmap_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heatmap_widget_info" />
        </receiver>

        <receiver
            android:name=".widgets.GoalBalanceWidgetProvider"
            android:exported="false"
            android:label="@string/widget_goal_balance_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/goal_balance_widget_info" />
        </receiver>

        <!--
          Fully qualified (bukan relatif ".widgets.XXX") karena launcher
          app (proses LAIN) yang manggil activity ini buat konfigurasi
          widget pas ditambahin, jadi exported="true" WAJIB. Beda sama
          <receiver> di atas yang tetap kena trigger sistem meskipun
          exported="false" (widget update broadcast lewat jalur khusus
          system, activity launch cross-app biasa enggak).
        -->
        <activity
            android:name="expo.modules.homewidgets.widgets.GoalBalanceConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
