{
  "expo": {
    "name": "Heibi",
    "slug": "heibi",
    "version": "3.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heibi",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1d1c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.immz.heibi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FB",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#1b1d1c"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi butuh akses galeri supaya kamu bisa memilih gambar untuk goal tabunganmu."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A985E0",
          "defaultChannel": "savings"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "RobotoFlex",
                "fontDefinitions": [
                  { "path": "./assets/fonts/RobotoFlex-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/RobotoFlex-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/RobotoFlex-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      "./plugins/withAndroidApkSize"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64aa6cb6-2934-4ce9-b567-2fedb65da08f"
      }
    },
    "owner": "karimms1620"
  }
}
